{
  "name": "glimpse",
  "productName": "Glimpse",
  "version": "0.1.0",
  "private": true,
  "description": "Highlight videos from Meta glasses footage: Gemini finds the best moments, ffmpeg cuts them.",
  "main": "./out/main/index.js",
  "author": "Jan Fabig",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "HC_LIVE_GEMINI=1 vitest run src/main/ai/live.test.ts",
    "test:e2e": "electron-vite build && tsc -p e2e/tsconfig.json && playwright test -c e2e/playwright.config.ts",
    "testvideos": "node scripts/make-test-videos.mjs",
    "ui:snap": "node scripts/ui-snap.mjs",
    "package": "npm run build && electron-builder --mac --dir && node build/verify-package.mjs --static-only",
    "package:zip": "npm run package && node build/make-zip.mjs",
    "package:dmg": "npm run build && electron-builder --mac dmg && node build/verify-package.mjs --static-only",
    "verify:package": "node build/verify-package.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/genai": "^2.32.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource/montserrat": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.66.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
